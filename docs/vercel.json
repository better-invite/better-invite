{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"redirects": [
		{
			"source": "/",
			"has": [
				{
					"type": "host",
					"value": "better-invite-plugin.vercel.app"
				}
			],
			"destination": "https://www.better-invite.com/blog/0-5",
			"permanent": true
		},
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "better-invite-plugin.vercel.app"
				}
			],
			"destination": "https://www.better-invite.com/:path*",
			"permanent": true
		}
	]
}
